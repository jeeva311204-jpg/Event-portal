<style>
:root{--bg:#0b1428;--panel:#111e38;--card:#f8f3e8;--gold:#d4a73d;--muted:#8fa0bf;--line:#2b3955;--danger:#ef4444;--success:#16a34a}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;font-family:Segoe UI,Arial,sans-serif;background:radial-gradient(circle at 20% 20%, #0d061f 0%, #05010e 50%, #020005 100%);color:#e2e8f0;min-height:100vh}
nav{position:sticky;top:0;z-index:50;padding:14px 28px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid rgba(255,255,255,0.1);background:rgba(13,6,31,0.85);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);gap:14px}
.logo{font-size:21px;font-weight:800;cursor:pointer;color:#d4a73d;white-space:nowrap;transition:all 0.3s ease;text-shadow:0 0 15px rgba(217,40,255,0.5)}.logo:hover{color:#ff00ff;text-shadow:0 0 25px rgba(255,0,255,0.8)}.nav-links{display:flex;gap:7px;align-items:center;flex-wrap:wrap;justify-content:flex-end}
.container{max-width:1200px;margin:auto;padding:28px 18px;position:relative;z-index:1}.card{background:rgba(255,255,255,0.04);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);color:#e2e8f0;padding:24px;border:1px solid rgba(255,255,255,0.1);border-radius:14px;margin-bottom:18px;box-shadow:0 8px 25px rgba(0,0,0,0.3);transition:all 0.3s ease}
.card:hover{border-color:rgba(0,240,255,0.4);transform:translateY(-5px);box-shadow:0 15px 40px rgba(138,43,226,0.25)}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:16px}.events{display:grid;grid-template-columns:repeat(auto-fit,minmax(290px,1fr));gap:18px}
.event{background:rgba(255,255,255,0.04);backdrop-filter:blur(14px);color:#e2e8f0;padding:20px;border:1px solid rgba(255,255,255,0.1);border-radius:14px;display:flex;flex-direction:column;justify-content:space-between;box-shadow:0 5px 18px rgba(0,0,0,0.2);transition:all 0.3s ease,transform 0.2s ease}
.event:hover{transform:translateY(-6px);border-color:rgba(0,240,255,0.5);box-shadow:0 20px 45px rgba(138,43,226,0.3)}
input,select,textarea{width:100%;padding:11px;margin:6px 0 12px;border:1px solid rgba(255,255,255,0.2);border-radius:7px;font-size:14px;background:rgba(255,255,255,0.08);color:#e2e8f0;transition:all 0.2s ease}
input:focus,select:focus,textarea:focus{outline:none;background:rgba(255,255,255,0.12);border-color:rgba(0,240,255,0.5);box-shadow:0 0 12px rgba(0,240,255,0.3)}
input::placeholder,select::placeholder,textarea::placeholder{color:rgba(226,232,240,0.5)}
button,.btn{padding:10px 15px;border:0;border-radius:7px;cursor:pointer;background:linear-gradient(135deg,#7928ca 0%,#4338ca 100%);color:#ffffff;font-weight:700;text-decoration:none;display:inline-block;font-size:14px;transition:all 0.2s ease,box-shadow 0.3s ease}
button:hover,.btn:hover{transform:translateY(-2px);box-shadow:0 0 18px rgba(121,40,202,0.6);filter:brightness(1.1)}button:disabled{opacity:.5;cursor:not-allowed;transform:none}
.btn-secondary{background:rgba(57,69,98,0.7);color:#fff;border:1px solid rgba(255,255,255,0.1);backdrop-filter:blur(10px)}.btn-secondary:hover{background:rgba(57,69,98,0.9);border-color:rgba(0,240,255,0.3)}
.btn-danger{background:linear-gradient(135deg,#ef4444 0%,#dc2626 100%);color:#fff}.btn-danger:hover{box-shadow:0 0 15px rgba(239,68,68,0.5)}
.btn-success{background:linear-gradient(135deg,#16a34a 0%,#15803d 100%);color:#fff}.btn-success:hover{box-shadow:0 0 15px rgba(22,163,74,0.5)}
.actions{display:flex;gap:8px;flex-wrap:wrap}.badge{display:inline-block;padding:4px 10px;border-radius:20px;background:linear-gradient(135deg,#d4a73d 0%,#b8860b 100%);color:#0d061f;font-size:12px;font-weight:800;box-shadow:0 4px 12px rgba(212,167,61,0.3)}
.error{color:#ff6b9d;font-weight:700}.success{color:#4ade80;font-weight:700}.muted{color:#94a3b8}.small{font-size:13px}
.hero{background:linear-gradient(135deg,rgba(22,40,73,0.8),rgba(14,25,48,0.8));border:1px solid rgba(255,255,255,0.1);color:#e2e8f0;padding:40px;border-radius:16px;backdrop-filter:blur(12px);margin-bottom:30px;text-shadow:0 2px 10px rgba(0,0,0,0.5)}.hero h1{margin-top:0;font-size:34px;color:#00f0ff;text-shadow:0 0 20px rgba(0,240,255,0.5)}
.stat{padding:18px;border-radius:12px;background:rgba(24,38,64,0.6);color:#e2e8f0;border:1px solid rgba(255,255,255,0.1);backdrop-filter:blur(10px);transition:all 0.3s ease}.stat:hover{border-color:rgba(0,240,255,0.3);transform:translateY(-3px)}.stat strong{display:block;font-size:30px;color:#d4a73d;text-shadow:0 0 10px rgba(212,167,61,0.5)}
.table-wrap{overflow:auto}.table{width:100%;border-collapse:collapse;color:#e2e8f0;background:rgba(255,255,255,0.02)}.table th,.table td{padding:11px;border-bottom:1px solid rgba(255,255,255,0.1);text-align:left;vertical-align:middle}.table th{background:rgba(212,167,61,0.15);font-weight:700;color:#d4a73d}
.qr{max-width:240px;display:block;margin:15px auto;padding:15px;background:white;border-radius:10px;box-shadow:0 8px 25px rgba(0,0,0,0.4)}.notif{background:rgba(255,255,255,0.08);border:1px solid rgba(255,255,255,0.1);border-radius:10px;padding:15px;margin:10px 0;backdrop-filter:blur(10px);transition:all 0.2s ease}.notif:hover{background:rgba(255,255,255,0.12);border-color:rgba(0,240,255,0.3)}.notif.unread{border-left:5px solid #d4a73d;box-shadow:0 0 12px rgba(212,167,61,0.2)}
#toast-banner{position:fixed;top:75px;right:18px;background:linear-gradient(135deg,#16a34a 0%,#15803d 100%);color:#fff;padding:14px 18px;border-radius:9px;box-shadow:0 5px 20px rgba(22,163,74,0.4);display:none;z-index:1000;font-weight:700;max-width:360px;backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,0.2)}
#reader{width:100%;max-width:430px;margin:15px auto;border-radius:10px;overflow:hidden;background:#000;border:2px solid rgba(0,240,255,0.3);box-shadow:0 0 20px rgba(0,240,255,0.2)}.scan-result{padding:14px;border-radius:8px;margin-top:12px;font-weight:700}.scan-ok{background:rgba(34,197,94,0.2);color:#4ade80;border:1px solid rgba(34,197,94,0.4)}.scan-warn{background:rgba(234,179,8,0.2);color:#facc15;border:1px solid rgba(234,179,8,0.4)}.scan-err{background:rgba(239,68,68,0.2);color:#ff6b9d;border:1px solid rgba(239,68,68,0.4)}
.live-feed{max-height:280px;overflow:auto;margin-top:10px;background:rgba(0,0,0,0.3);border:1px solid rgba(255,255,255,0.1);border-radius:8px;backdrop-filter:blur(8px)}.live-feed div{padding:9px;border-bottom:1px solid rgba(255,255,255,0.05);font-size:13px;color:#cbd5e1}
.modal-backdrop{position:fixed;inset:0;background:rgba(0,0,0,0.7);display:none;align-items:center;justify-content:center;z-index:200;backdrop-filter:blur(4px)}.modal{width:min(560px,92vw);max-height:90vh;overflow:auto;background:rgba(13,6,31,0.95);backdrop-filter:blur(14px);color:#e2e8f0;padding:24px;border:1px solid rgba(255,255,255,0.1);border-radius:14px;box-shadow:0 20px 60px rgba(138,43,226,0.3)}
.empty{text-align:center;padding:35px;color:#64748b}.star{font-size:25px;cursor:pointer;color:#94a3b8;transition:all 0.2s ease}.star:hover{color:#d4a73d;transform:scale(1.2)}.star.on{color:#ffd700;text-shadow:0 0 10px rgba(255,215,0,0.6)}
#galaxy-bg{position:fixed;top:0;left:0;width:100%;height:100%;z-index:-1;pointer-events:none}
@media(max-width:700px){nav{padding:12px 14px}.nav-links{width:100%;justify-content:flex-start}.hero h1{font-size:27px}.container{padding:18px 12px}}
</style>
</head>
<body>
<canvas id="galaxy-bg"></canvas>
<div id="toast-banner"></div>
<nav>
  <div class="logo" onclick="loadHome()">
    <i class="fas fa-bullseye"></i> Event Portal
  </div>
  <div class="nav-links" id="nav"></div>
</nav>
<main class="container"><div id="app"></div></main>
<div id="modalRoot" class="modal-backdrop"></div>
    <div class="container" id="app">
    <div class="card" style="max-width:420px;margin:50px auto;">
      
      <!-- Login View -->
      <div id="login-view">
        <h2 style="text-align:center;color:#d4a73d;margin-bottom:20px;">Portal Login</h2>
        
        <label style="font-size:13px;color:#8fa0bf;">Select Role</label>
        <select id="role" style="width:100%;padding:10px;margin:6px 0 14px;border-radius:7px;background:rgba(255,255,255,0.08);color:#e2e8f0;border:1px solid rgba(255,255,255,0.2);">
          <option value="student" style="background:#111e38;">Student</option>
          <option value="organizer" style="background:#111e38;">Organizer</option>
          <option value="admin" style="background:#111e38;">Admin</option>
        </select>

        <label style="font-size:13px;color:#8fa0bf;">Email</label>
        <input type="email" id="email" placeholder="admin@college.edu" required>

        <label style="font-size:13px;color:#8fa0bf;">Password</label>
        <input type="password" id="password" placeholder="Enter password" required>

        <button class="btn" style="width:100%;margin-top:14px;" onclick="handleLoginSubmit()">Send OTP / Login</button>

        <div style="display:flex;justify-content:space-between;margin-top:14px;font-size:13px;">
          <a href="#register" style="color:#8fa0bf;" onclick="alert('Register screen coming soon')">Register</a>
          <a href="#forgot" style="color:#8fa0bf;" onclick="alert('Reset password option coming soon')">Forgot Password?</a>
        </div>

        <div style="margin-top:20px;padding-top:15px;border-top:1px solid rgba(255,255,255,0.1);font-size:12px;color:#8fa0bf;">
          <strong>Demo Credentials:</strong><br>
          • Admin: <code>admin@college.edu</code> / <code>admin123</code><br>
          • Student: <code>student@college.edu</code> / <code>student123</code><br>
          • Organizer: <code>organizer@college.edu</code> / <code>org123</code>
        </div>
      </div>

      <!-- OTP View (Hidden by default) -->
      <div id="otp-view" style="display:none;">
        <h2 style="text-align:center;color:#d4a73d;margin-bottom:10px;">Enter OTP</h2>
        <p style="text-align:center;font-size:13px;color:#8fa0bf;">Check your email for the 6-digit verification code.</p>
        
        <input type="text" id="otp" placeholder="123456" maxlength="6" style="text-align:center;font-size:18px;letter-spacing:4px;" required>
        
        <button class="btn" style="width:100%;margin-top:14px;" onclick="verifyOtpAndRedirect()">Verify & Continue</button>
        <button class="btn btn-secondary" style="width:100%;margin-top:8px;" onclick="showLoginView()">Back to Login</button>
      </div>

      <!-- Event Dashboard (Hidden by default) -->
      <div id="event-view" style="display:none;">
        <h2 style="color:#d4a73d;" id="welcome-header">Welcome to Events</h2>
        <p id="role-badge" style="color:#8fa0bf;font-size:14px;"></p>
        <hr style="border-color:rgba(255,255,255,0.1);margin:15px 0;">
        <p>Loading active events...</p>
        <button class="btn btn-danger" style="margin-top:15px;" onclick="showLoginView()">Logout</button>
      </div>

    </div>
  </div>
<script>
  const socket=io();
  let token=localStorage.getItem("token");
  let user=null;
  try { user=JSON.parse(localStorage.getItem("user")||"null"); } catch(e){}
  let pendingUserId=null, html5QrCode=null, scannerLocked=false, currentScannerEvent=null;

  socket.on("connect",()=>{if(user && user.id)socket.emit("join_user_room",user.id)});
  socket.on("realtime_notification",n=>{showToast("?? "+n.title+": "+n.message); nav()});
  socket.on("broadcast_announcement",a=>showToast("?? "+a.title+": "+a.message));
  socket.on("seat_update",()=>{if(document.getElementById("events"))refreshSeatsQuietly()});
  socket.on("checkin_broadcast",d=>{
   showToast("? "+d.userName+" checked in for "+d.eventTitle);
   const feed=document.getElementById("live-feed"); if(feed){const row=document.createElement("div");row.textContent=d.userName+" – "+d.eventTitle+" – "+new Date(d.attendedAt).toLocaleTimeString();feed.prepend(row)}
  });

  function showToast(msg){const t=document.getElementById("toast-banner");t.textContent=msg;t.style.display="block";clearTimeout(showToast.timer);showToast.timer=setTimeout(()=>t.style.display="none",4500)}
  function esc(v){return String(v??"").replace(/[&<>"']/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[m]))}
  function fmtDate(d){if(!d)return "-";const x=new Date(d+"T00:00:00");return isNaN(x)?d:x.toLocaleDateString("en-IN",{day:"2-digit",month:"short",year:"numeric"})}
  function fmtTime(t){if(!t)return "-";const [h,m]=t.split(":");const d=new Date();d.setHours(+h,+m);return d.toLocaleTimeString("en-IN",{hour:"2-digit",minute:"2-digit"})}

  async function api(url,options={}){
   options.headers=options.headers||{}; if(!(options.body instanceof FormData))options.headers["Content-Type"]="application/json";
   if(token) options.headers["Authorization"]="Bearer "+token;
   const res = await fetch(url, options);
   return res.json();
  }
  function handleLoginSubmit() {
    const email = document.getElementById('email').value;
    const password = document.getElementById('password').value;
    if(!email || !password) {
      alert("Please enter both email and password.");
      return;
    }
    document.getElementById('login-view').style.display = 'none';
    document.getElementById('otp-view').style.display = 'block';
  }

  function verifyOtpAndRedirect() {
    const otp = document.getElementById('otp').value;
    const role = document.getElementById('role').value;
    const email = document.getElementById('email').value;

    if(otp.length < 4) {
      alert("Please enter a valid OTP.");
      return;
    }

    document.getElementById('otp-view').style.display = 'none';
    document.getElementById('event-view').style.display = 'block';
    document.getElementById('welcome-header').innerText = "Welcome, " + email;
    document.getElementById('role-badge').innerText = "Role: " + role.toUpperCase();
  }

  function showLoginView() {
    document.getElementById('event-view').style.display = 'none';
    document.getElementById('otp-view').style.display = 'none';
    document.getElementById('login-view').style.display = 'block';
  }
</script>
