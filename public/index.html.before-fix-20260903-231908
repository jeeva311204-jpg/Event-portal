async function organizerDashboard(){
 if(!user||!["admin","organizer"].includes(user.role)){showLogin();return}await nav();
 try{
  const events=await api("/api/events");const mine=user.role==="admin"?events:events.filter(e=>String(e.organizerId)===String(user.id)||e.organizerName===user.name);
  const total=mine.length,reg=mine.reduce((a,e)=>a+e.registered,0),seats=mine.reduce((a,e)=>a+e.maxSeats,0),avg=mine.filter(e=>e.avgRating).length?(mine.filter(e=>e.avgRating).reduce((a,e)=>a+Number(e.avgRating),0)/mine.filter(e=>e.avgRating).length).toFixed(1):"—";
  setApp(`<div class="card hero"><div class="actions" style="justify-content:space-between"><div><h1>${user.role==="admin"?"Admin":"Organizer"} Dashboard</h1><p>Manage events, registrations and live attendance.</p></div><button onclick="showCreateEvent()">＋ Create Event</button></div><div class="grid"><div class="stat"><span>Events</span><strong>${total}</strong></div><div class="stat"><span>Registrations</span><strong>${reg}</strong></div><div class="stat"><span>Total Seats</span><strong>${seats}</strong></div><div class="stat"><span>Average Rating</span><strong>${avg}</strong></div></div></div><div class="events">${mine.length?mine.map(e=>eventManagerCard(e)).join(""):'<div class="card empty">No events created yet.</div>'}</div>`)
 }catch(e){setApp(`<div class="card"><p class="error">${esc(e.message)}</p></div>`)}
}
function eventManagerCard(e){return `<article class="event"><div><span class="badge">${esc(e.category)}</span><h2>${esc(e.title)}</h2><p>${fmtDate(e.date)} · ${fmtTime(e.time)} · ${esc(e.venue)}</p><p><b>${e.registered}</b> / ${e.maxSeats} registered · ${e.seatsLeft} seats left</p><p>Status: <b>${esc(e.status)}</b>${e.avgRating?` · ⭐ ${e.avgRating}`:""}</p></div><div class="actions"><button onclick="viewRegistrations('${e.id}')">Attendees</button><button onclick="editEvent('${e.id}')">Edit</button><button onclick="showScanner('${e.id}')">Scan</button><button class="btn-danger" onclick="deleteEvent('${e.id}')">Delete</button></div></article>`}
function showCreateEvent(e=null){
 setApp(`<div class="card"><h1>${e?"Edit Event":"Create Event"}</h1><input id="etitle" placeholder="Event Title" value="${esc(e?.title||"")}"><textarea id="edesc" rows="3" placeholder="Description">${esc(e?.description||"")}</textarea><select id="ecat">${["Technical","Cultural","Sports","Workshop"].map(x=>`<option ${e?.category===x?"selected":""}>${x}</option>`).join("")}</select><input id="edate" type="date" value="${esc(e?.date||"")}"><input id="etime" type="time" value="${esc(e?.time||"")}"><input id="evenue" placeholder="Venue" value="${esc(e?.venue||"")}"><input id="edept" placeholder="Department" value="${esc(e?.department||"All Departments")}"><input id="eseats" type="number" min="1" value="${e?.maxSeats||50}"><select id="estatus">${["upcoming","ongoing","completed","cancelled"].map(x=>`<option ${e?.status===x?"selected":""}>${x}</option>`).join("")}</select><p id="createError" class="error"></p><div class="actions"><button onclick="saveEvent(${e?`'${e.id}'`:"null"})">${e?"Save Changes":"Publish Event"}</button><button class="btn-secondary" onclick="organizerDashboard()">Cancel</button></div></div>`)
}
async function editEvent(id){try{showCreateEvent(await api("/api/events/"+id))}catch(e){alert(e.message)}}
async function saveEvent(id){
 const payload={title:document.getElementById("etitle").value.trim(),description:document.getElementById("edesc").value.trim(),category:document.getElementById("ecat").value,date:document.getElementById("edate").value,time:document.getElementById("etime").value,venue:document.getElementById("evenue").value.trim(),department:document.getElementById("edept").value.trim()||"All Departments",maxSeats:document.getElementById("eseats").value,status:document.getElementById("estatus").value};
 try{await api(id?"/api/events/"+id:"/api/events",{method:id?"PUT":"POST",body:JSON.stringify(payload)});showToast(id?"Event updated":"Event published");organizerDashboard()}catch(e){document.getElementById("createError").textContent=e.message}}
async function deleteEvent(id){if(!confirm("Delete this event and notify all attendees?"))return;try{await api("/api/events/"+id,{method:"DELETE"});showToast("Event deleted");organizerDashboard()}catch(e){alert(e.message)}}
async function exportAttendeesCsv(id){try{const r=await fetch("/api/events/"+id+"/registrations/export",{headers:{Authorization:"Bearer "+token}});if(!r.ok){const x=await r.json();throw new Error(x.error)}const blob=await r.blob(),url=URL.createObjectURL(blob),a=document.createElement("a");a.href=url;a.download="attendees.csv";a.click();setTimeout(()=>URL.revokeObjectURL(url),1000)}catch(e){alert(e.message)}}
async function viewRegistrations(id){
 try{const e=await api("/api/events/"+id),regs=await api("/api/events/"+id+"/registrations");setApp(`<div class="card"><div class="actions"><button class="btn-secondary" onclick="organizerDashboard()">← Dashboard</button><h1>${esc(e.title)} — Attendees</h1><button class="btn-secondary" onclick="exportAttendeesCsv('${id}')">⬇ Export CSV</button></div><p>${regs.length} registrations · ${regs.filter(r=>r.attended).length} checked in</p><div class="table-wrap"><table class="table"><thead><tr><th>Name</th><th>Email</th><th>Phone</th><th>Status</th><th>Registered</th></tr></thead><tbody>${regs.length?regs.map(r=>`<tr><td>${esc(r.userName)}</td><td>${esc(r.userEmail)}</td><td>${esc(r.userPhone)}</td><td>${r.attended?'<span class="success">Checked in</span>':'Registered'}</td><td>${new Date(r.createdAt).toLocaleString("en-IN")}</td></tr>`).join(""):'<tr><td colspan="5">No registrations.</td></tr>'}</tbody></table></div></div>`)}catch(e){alert(e.message)}}

async function showNotifications(){
 if(!user){showLogin();return}await nav();try{const a=await api("/api/notifications");await api("/api/notifications/mark-read",{method:"POST"});setApp(`<div class="card"><div class="actions" style="justify-content:space-between"><h1>Notifications</h1><button class="btn-secondary" onclick="loadHome()">Back</button></div>${a.length?a.map(n=>`<div class="notif ${n.read?"":"unread"}"><h3>${esc(n.title)}</h3><p>${esc(n.message)}</p><small>${new Date(n.createdAt).toLocaleString("en-IN")}</small></div>`).join(""):'<div class="empty">No notifications.</div>'}</div>`)}catch(e){alert(e.message)}}

async function showScanner(eventId=null){
 if(!user||!["admin","organizer"].includes(user.role)){alert("Organizer/Admin access required");return}await nav();currentScannerEvent=eventId;
 setApp(`<div class="card"><div class="actions"><button class="btn-secondary" onclick="organizerDashboard()">← Dashboard</button><h1>Live Ticket Scanner</h1></div><p>Scan a student's QR ticket to verify attendance. If the camera isn't working, ask the student for their 6-digit check-in code and type it below instead.</p><div id="reader"></div><div class="actions" style="max-width:650px;margin:auto"><input id="manualQr" placeholder="6-digit check-in code, or paste QR token" style="margin:0"><button onclick="manualScan()">Verify</button></div><div id="scanStatus"></div><h3>Live check-in feed</h3><div class="live-feed" id="live-feed"></div></div>`);
 html5QrCode=new Html5Qrcode("reader");
 try{const cams=await Html5Qrcode.getCameras();if(!cams.length)throw new Error("No camera found");const cam=cams.find(c=>/back|rear|environment/i.test(c.label))||cams[cams.length-1];await html5QrCode.start(cam.id,{fps:10,qrbox:250},onScanSuccess,()=>{})}
 catch(err){document.getElementById("scanStatus").innerHTML=`<div class="scan-result scan-err">Camera unavailable: ${esc(err.message||err)}. Use the manual token field or allow camera access.</div>`}
}
async function manualScan(){const v=document.getElementById("manualQr").value.trim();if(!v)return;if(scannerLocked)return;scannerLocked=true;try{const body=/^\d{6}$/.test(v)?{checkinCode:v}:{qrPayload:v};const d=await api("/api/scan",{method:"POST",body:JSON.stringify(body)});const b=document.getElementById("scanStatus");b.innerHTML=`<div class="scan-result ${d.alreadyCheckedIn?"scan-warn":"scan-ok"}">${d.alreadyCheckedIn?"Already checked in":"✓ Attendance marked"}: ${esc(d.name)} — ${esc(d.eventTitle)}</div>`;document.getElementById("manualQr").value=""}catch(e){const b=document.getElementById("scanStatus");if(b)b.innerHTML=`<div class="scan-result scan-err">${esc(e.message)}</div>`}finally{setTimeout(()=>scannerLocked=false,1800)}}
async function onScanSuccess(decoded){
 if(scannerLocked)return;scannerLocked=true;
 try{const d=await api("/api/scan",{method:"POST",body:JSON.stringify({qrPayload:decoded})});const b=document.getElementById("scanStatus");b.innerHTML=`<div class="scan-result ${d.alreadyCheckedIn?"scan-warn":"scan-ok"}">${d.alreadyCheckedIn?"Already checked in":"✓ Attendance marked"}: ${esc(d.name)} — ${esc(d.eventTitle)}</div>`}
 catch(e){const b=document.getElementById("scanStatus");if(b)b.innerHTML=`<div class="scan-result scan-err">${esc(e.message)}</div>`}
 finally{setTimeout(()=>scannerLocked=false,1800)}
}
function stopScanner(){if(html5QrCode){html5QrCode.stop().then(()=>html5QrCode.clear()).catch(()=>{});html5QrCode=null}}

