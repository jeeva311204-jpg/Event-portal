<script>
(function(){
  var canvas=document.getElementById("galaxy-bg");
  var ctx=canvas.getContext("2d");
  var stars=[], w, h;
  function resize(){w=canvas.width=window.innerWidth;h=canvas.height=window.innerHeight}
  function makeStars(n){
    stars=[];
    for(var i=0;i<n;i++){
      stars.push({
        x:Math.random()*w,
        y:Math.random()*h,
        r:Math.random()*1.4+0.3,
        speed:Math.random()*0.15+0.02,
        twinkle:Math.random()*Math.PI*2,
        hue:Math.random()<0.15?"#a78bfa":(Math.random()<0.3?"#67e8f9":"#e2e8f0")
      });
    }
  }
  function draw(){
    ctx.clearRect(0,0,w,h);
    var grad=ctx.createRadialGradient(w*0.2,h*0.15,0,w*0.2,h*0.15,Math.max(w,h)*0.7);
    grad.addColorStop(0,"rgba(90,40,150,0.18)");
    grad.addColorStop(0.5,"rgba(20,10,40,0.08)");
    grad.addColorStop(1,"rgba(0,0,0,0)");
    ctx.fillStyle=grad;
    ctx.fillRect(0,0,w,h);
    for(var i=0;i<stars.length;i++){
      var s=stars[i];
      s.twinkle+=0.02;
      var alpha=0.5+Math.sin(s.twinkle)*0.5;
      ctx.beginPath();
      ctx.arc(s.x,s.y,s.r,0,Math.PI*2);
      ctx.fillStyle=s.hue;
      ctx.globalAlpha=alpha;
      ctx.fill();
      s.y+=s.speed;
      if(s.y>h){s.y=0;s.x=Math.random()*w}
    }
    ctx.globalAlpha=1;
    requestAnimationFrame(draw);
  }
  window.addEventListener("resize",function(){resize();makeStars(Math.floor((w*h)/9000))});
  resize();
  makeStars(Math.floor((w*h)/9000));
  draw();
})();
</script>

