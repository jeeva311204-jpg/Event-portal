async function adminPanel(){
 if(user?.role!=="admin"){alert("Admin access required");return}await nav();
 try{const [stats,users]=await Promise.all([api("/api/admin/stats"),api("/api/admin/users")]);setApp(`<div class="card hero"><h1>Admin Control Panel</h1><div class="grid"><div class="stat"><span>Total Users</span><strong>${stats.users}</strong></div><div class="stat"><span>Students</span><strong>${stats.students}</strong></div><div class="stat"><span>Organizers</span><strong>${stats.organizers}</strong></div><div class="stat"><span>Events</span><strong>${stats.events}</strong></div><div class="stat"><span>Registrations</span><strong>${stats.registrations}</strong></div><div class="stat"><span>Attendance</span><strong>${stats.attended}</strong></div></div></div><div class="card"><div class="actions" style="justify-content:space-between"><h2>User Management</h2><button onclick="showAddUser()">＋ Add User</button></div><input id="userSearch" placeholder="Search users..." oninput="filterUsers()"><div class="table-wrap"><table class="table"><thead><tr><th>Name</th><th>Email</th><th>Department</th><th>Role</th><th>Actions</th></tr></thead><tbody id="usersBody">${userRows(users)}</tbody></table></div></div>`);window._users=users}catch(e){alert(e.message)}}
function userRows(users){if(!users.length)return'<tr><td colspan="5">No users found.</td></tr>';return users.map(u=>`<tr><td>${esc(u.name)}</td><td>${esc(u.email)}</td><td>${esc(u.department)}</td><td><select onchange="changeRole('${u._id}',this.value)"><option ${u.role==="student"?"selected":""}>student</option><option ${u.role==="organizer"?"selected":""}>organizer</option><option ${u.role==="admin"?"selected":""}>admin</option></select></td><td><button class="btn-danger" onclick="removeUser('${u._id}')">Delete</button></td></tr>`).join("")}
function filterUsers(){const q=(document.getElementById("userSearch").value||"").toLowerCase();document.getElementById("usersBody").innerHTML=userRows((window._users||[]).filter(u=>(u.name+" "+u.email+" "+u.department+" "+u.role).toLowerCase().includes(q)))}
async function changeRole(id,newRole){try{await api("/api/admin/users/"+id+"/role",{method:"PATCH",body:JSON.stringify({role:newRole})});showToast("Role updated");adminPanel()}catch(e){alert(e.message)}}
async function removeUser(id){if(!confirm("Delete this user and their registrations?"))return;try{await api("/api/admin/users/"+id,{method:"DELETE"});showToast("User deleted");adminPanel()}catch(e){alert(e.message)}}
function showAddUser(){document.getElementById("modalRoot").style.display="flex";document.getElementById("modalRoot").innerHTML=`<div class="modal"><h2>Add User</h2><input id="aname" placeholder="Full Name"><input id="aemail" type="email" placeholder="Email"><input id="aphone" placeholder="Phone e.g. +919876543210"><input id="apass" type="password" placeholder="Password"><input id="adept" placeholder="Department"><select id="arole"><option>student</option><option>organizer</option><option>admin</option></select><p id="addErr" class="error"></p><div class="actions"><button onclick="addUser()">Create</button><button class="btn-secondary" onclick="closeModal()">Cancel</button></div></div>`}
async function addUser(){try{await api("/api/admin/users",{method:"POST",body:JSON.stringify({name:document.getElementById("aname").value,email:document.getElementById("aemail").value,phone:document.getElementById("aphone").value,password:document.getElementById("apass").value,department:document.getElementById("adept").value,role:document.getElementById("arole").value})});closeModal();adminPanel();showToast("User created")}catch(e){document.getElementById("addErr").textContent=e.message}}

async function load(){await nav();if(user)loadHome();else showLogin()}
load();
