 await nav();try{const d=await api("/api/me");const u=d.user;setApp(`<div class="card" style="max-width:650px;margin:auto"><h1>My Profile</h1><p class="muted">Account role: <b>${esc(u.role)}</b> · ${esc(u.email)}</p><input id="pname" value="${esc(u.name)}" placeholder="Name"><input id="pphone" value="${esc(u.phone)}" placeholder="Phone"><input id="pdept" value="${esc(u.department)}" placeholder="Department"><hr><h3>Change Password</h3><input id="pcurrent" type="password" placeholder="Current password"><input id="pnew" type="password" placeholder="New password (leave blank to keep current)"><p id="profileErr" class="error"></p><div class="actions"><button onclick="saveProfile()">Save Profile</button><button class="btn-secondary" onclick="loadHome()">Cancel</button></div></div>`)}catch(e){alert(e.message)}}
