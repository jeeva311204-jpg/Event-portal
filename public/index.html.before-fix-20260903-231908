<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#0d061f">
<title>College Event Portal</title>
<script src="/socket.io/socket.io.js"></script>
<script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>
<style>
:root{--bg:#0b1428;--panel:#111e38;--card:#f8f3e8;--gold:#d4a73d;--muted:#8fa0bf;--line:#2b3955;--danger:#ef4444;--success:#16a34a}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;font-family:Segoe UI,Arial,sans-serif;background:radial-gradient(circle at 20% 20%, #0d061f 0%, #05010e 50%, #020005 100%);color:#e2e8f0;min-height:100vh}
nav{position:sticky;top:0;z-index:50;padding:14px 28px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid rgba(255,255,255,0.1);background:rgba(13,6,31,0.85);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);gap:14px}
.logo{font-size:21px;font-weight:800;cursor:pointer;color:#d4a73d;white-space:nowrap;transition:all 0.3s ease;text-shadow:0 0 15px rgba(217,40,255,0.5)}.logo:hover{color:#ff00ff;text-shadow:0 0 25px rgba(255,0,255,0.8)}.nav-links{display:flex;gap:7px;align-items:center;flex-wrap:wrap;justify-content:flex-end}
.container{max-width:1200px;margin:auto;padding:28px 18px;position:relative;z-index:1}.card{background:rgba(255,255,255,0.04);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);color:#e2e8f0;padding:24px;border:1px solid rgba(255,255,255,0.1);border-radius:14px;margin-bottom:18px;box-shadow:0 8px 25px rgba(0,0,0,0.3);transition:all 0.3s ease}
.card:hover{border-color:rgba(0,240,255,0.4);transform:translateY(-5px);box-shadow:0 15px 40px rgba(138,43,226,0.25)}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:16px}.events{display:grid;grid-template-columns:repeat(auto-fit,minmax(290px,1fr));gap:18px}
.event{background:rgba(255,255,255,0.04);backdrop-filter:blur(14px);color:#e2e8f0;padding:20px;border:1px solid rgba(255,255,255,0.1);border-radius:14px;display:flex;flex-direction:column;justify-content:space-between;box-shadow:0 5px 18px rgba(0,0,0,0.2);transition:all 0.3s ease,transform 0.2s ease}
.event:hover{transform:translateY(-6px);border-color:rgba(0,240,255,0.5);box-shadow:0 20px 45px rgba(138,43,226,0.3)}
input,select,textarea{width:100%;padding:11px;margin:6px 0 12px;border:1px solid rgba(255,255,255,0.2);border-radius:7px;font-size:14px;background:rgba(255,255,255,0.08);color:#e2e8f0;transition:all 0.2s ease}
input:focus,select:focus,textarea:focus{outline:none;background:rgba(255,255,255,0.12);border-color:rgba(0,240,255,0.5);box-shadow:0 0 12px rgba(0,240,255,0.3)}
input::placeholder,select::placeholder,textarea::placeholder{color:rgba(226,232,240,0.5)}
button,.btn{padding:10px 15px;border:0;border-radius:7px;cursor:pointer;background:linear-gradient(135deg,#7928ca 0%,#4338ca 100%);color:#ffffff;font-weight:700;text-decoration:none;display:inline-block;font-size:14px;transition:all 0.2s ease,box-shadow 0.3s ease}
button:hover,.btn:hover{transform:translateY(-2px);box-shadow:0 0 18px rgba(121,40,202,0.6);filter:brightness(1.1)}button:disabled{opacity:.5;cursor:not-allowed;transform:none}
.btn-secondary{background:rgba(57,69,98,0.7);color:#fff;border:1px solid rgba(255,255,255,0.1);backdrop-filter:blur(10px)}.btn-secondary:hover{background:rgba(57,69,98,0.9);border-color:rgba(0,240,255,0.3)}
.btn-danger{background:linear-gradient(135deg,#ef4444 0%,#dc2626 100%);color:#fff}.btn-danger:hover{box-shadow:0 0 15px rgba(239,68,68,0.5)}
.btn-success{background:linear-gradient(135deg,#16a34a 0%,#15803d 100%);color:#fff}.btn-success:hover{box-shadow:0 0 15px rgba(22,163,74,0.5)}
.actions{display:flex;gap:8px;flex-wrap:wrap}.badge{display:inline-block;padding:4px 10px;border-radius:20px;background:linear-gradient(135deg,#d4a73d 0%,#b8860b 100%);color:#0d061f;font-size:12px;font-weight:800;box-shadow:0 4px 12px rgba(212,167,61,0.3)}
.error{color:#ff6b9d;font-weight:700}.success{color:#4ade80;font-weight:700}.muted{color:#94a3b8}.small{font-size:13px}
.hero{background:linear-gradient(135deg,rgba(22,40,73,0.8),rgba(14,25,48,0.8));border:1px solid rgba(255,255,255,0.1);color:#e2e8f0;padding:40px;border-radius:16px;backdrop-filter:blur(12px);margin-bottom:30px;text-shadow:0 2px 10px rgba(0,0,0,0.5)}.hero h1{margin-top:0;font-size:34px;color:#00f0ff;text-shadow:0 0 20px rgba(0,240,255,0.5)}
.stat{padding:18px;border-radius:12px;background:rgba(24,38,64,0.6);color:#e2e8f0;border:1px solid rgba(255,255,255,0.1);backdrop-filter:blur(10px);transition:all 0.3s ease}.stat:hover{border-color:rgba(0,240,255,0.3);transform:translateY(-3px)}.stat strong{display:block;font-size:30px;color:#d4a73d;text-shadow:0 0 10px rgba(212,167,61,0.5)}
.table-wrap{overflow:auto}.table{width:100%;border-collapse:collapse;color:#e2e8f0;background:rgba(255,255,255,0.02)}.table th,.table td{padding:11px;border-bottom:1px solid rgba(255,255,255,0.1);text-align:left;vertical-align:middle}.table th{background:rgba(212,167,61,0.15);font-weight:700;color:#d4a73d}
.qr{max-width:240px;display:block;margin:15px auto;padding:15px;background:white;border-radius:10px;box-shadow:0 8px 25px rgba(0,0,0,0.4)}.notif{background:rgba(255,255,255,0.08);border:1px solid rgba(255,255,255,0.1);border-radius:10px;padding:15px;margin:10px 0;backdrop-filter:blur(10px);transition:all 0.2s ease}.notif:hover{background:rgba(255,255,255,0.12);border-color:rgba(0,240,255,0.3)}.notif.unread{border-left:5px solid #d4a73d;box-shadow:0 0 12px rgba(212,167,61,0.2)}
#toast-banner{position:fixed;top:75px;right:18px;background:linear-gradient(135deg,#16a34a 0%,#15803d 100%);color:#fff;padding:14px 18px;border-radius:9px;box-shadow:0 5px 20px rgba(22,163,74,0.4);display:none;z-index:1000;font-weight:700;max-width:360px;backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,0.2)}
#reader{width:100%;max-width:430px;margin:15px auto;border-radius:10px;overflow:hidden;background:#000;border:2px solid rgba(0,240,255,0.3);box-shadow:0 0 20px rgba(0,240,255,0.2)}.scan-result{padding:14px;border-radius:8px;margin-top:12px;font-weight:700}.scan-ok{background:rgba(34,197,94,0.2);color:#4ade80;border:1px solid rgba(34,197,94,0.4)}.scan-warn{background:rgba(234,179,8,0.2);color:#facc15;border:1px solid rgba(234,179,8,0.4)}.scan-err{background:rgba(239,68,68,0.2);color:#ff6b9d;border:1px solid rgba(239,68,68,0.4)}
.live-feed{max-height:280px;overflow:auto;margin-top:10px;background:rgba(0,0,0,0.3);border:1px solid rgba(255,255,255,0.1);border-radius:8px;backdrop-filter:blur(8px)}.live-feed div{padding:9px;border-bottom:1px solid rgba(255,255,255,0.05);font-size:13px;color:#cbd5e1}
.modal-backdrop{position:fixed;inset:0;background:rgba(0,0,0,0.7);display:none;align-items:center;justify-content:center;z-index:200;backdrop-filter:blur(4px)}.modal{width:min(560px,92vw);max-height:90vh;overflow:auto;background:rgba(13,6,31,0.95);backdrop-filter:blur(14px);color:#e2e8f0;padding:24px;border:1px solid rgba(255,255,255,0.1);border-radius:14px;box-shadow:0 20px 60px rgba(138,43,226,0.3)}
.empty{text-align:center;padding:35px;color:#64748b}.star{font-size:25px;cursor:pointer;color:#94a3b8;transition:all 0.2s ease}.star:hover{color:#d4a73d;transform:scale(1.2)}.star.on{color:#ffd700;text-shadow:0 0 10px rgba(255,215,0,0.6)}
#galaxy-bg{position:fixed;top:0;left:0;width:100%;height:100%;z-index:-1;pointer-events:none;background:#05010e}
@media(max-width:700px){nav{padding:12px 14px}.nav-links{width:100%;justify-content:flex-start}.hero h1{font-size:27px}.container{padding:18px 12px}}
</style>
</head>
<body>
<canvas id="galaxy-bg"></canvas>
<div id="toast-banner"></div>
<nav><div class="logo" onclick="loadHome()">Event Portal</div><div class="nav-links" id="nav"></div></nav>
<main class="container"><div id="app"></div></main>
<div id="modalRoot" class="modal-backdrop"></div>

<script>
const socket=io();
let token=localStorage.getItem("token"), user=JSON.parse(localStorage.getItem("user")||"null");
let pendingUserId=null, html5QrCode=null, scannerLocked=false, currentScannerEvent=null;

socket.on("connect",()=>{if(user)socket.emit("join_user_room",user.id)});
socket.on("realtime_notification",n=>{showToast("🔔 "+n.title+": "+n.message); nav()});
socket.on("broadcast_announcement",a=>showToast("📢 "+a.title+": "+a.message));
socket.on("seat_update",()=>{if(document.getElementById("events"))refreshSeatsQuietly()});
socket.on("checkin_broadcast",d=>{
 showToast("✅ "+d.userName+" checked in for "+d.eventTitle);
 const feed=document.getElementById("live-feed"); if(feed){const row=document.createElement("div");row.textContent=d.userName+" — "+d.eventTitle+" — "+new Date(d.attendedAt).toLocaleTimeString();feed.prepend(row)}
});

function showToast(msg){const t=document.getElementById("toast-banner");t.textContent=msg;t.style.display="block";clearTimeout(showToast.timer);showToast.timer=setTimeout(()=>t.style.display="none",4500)}
function esc(v){return String(v??"").replace(/[&<>"']/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[m]))}
function fmtDate(d){if(!d)return "-";const x=new Date(d+"T00:00:00");return isNaN(x)?d:x.toLocaleDateString("en-IN",{day:"2-digit",month:"short",year:"numeric"})}
function fmtTime(t){if(!t)return "-";const [h,m]=t.split(":");const d=new Date();d.setHours(+h,+m);return d.toLocaleTimeString("en-IN",{hour:"2-digit",minute:"2-digit"})}

async function api(url,options={}){
 options.headers=options.headers||{}; if(!(options.body instanceof FormData))options.headers["Content-Type"]="application/json";
 if(token)options.headers.Authorization="Bearer "+token;
 const r=await fetch(url,options); let data=null; try{data=await r.json()}catch{}
 if(r.status===401&&token){logout(false);throw new Error(data?.error||"Session expired. Please login again.")}
 if(!r.ok)throw new Error(data?.error||"Request failed");
 return data;
}
function saveLogin(data){token=data.token;user=data.user;localStorage.setItem("token",token);localStorage.setItem("user",JSON.stringify(user));socket.emit("join_user_room",user.id)}
function logout(show=true){stopScanner();localStorage.removeItem("token");localStorage.removeItem("user");token=null;user=null;if(show)showToast("Logged out");load()}
async function nav(){
 const n=document.getElementById("nav");
 if(!user){n.innerHTML='<button onclick="showLogin()">Login</button>';return}
 let unread=0;try{const a=await api("/api/notifications");unread=a.filter(x=>!x.read).length}catch{}
 let b='<button onclick="loadHome()">Events</button>';
 if(user.role==="student")b+='<button onclick="myRegistrations()">My Registrations</button><button onclick="showNotifications()">Notifications'+(unread?" ("+unread+")":"")+'</button>';
 else b+='<button onclick="organizerDashboard()">Dashboard</button><button onclick="showScanner()">Live Scanner</button><button onclick="showNotifications()">Notifications'+(unread?" ("+unread+")":"")+'</button>';
 if(user.role==="admin")b+='<button onclick="adminPanel()">Users</button>';
 b+='<button onclick="profilePanel()">Profile</button><span style="font-weight:700;margin-left:4px">'+esc(user.name)+'</span><button class="btn-secondary" onclick="logout()">Logout</button>';
 n.innerHTML=b;
}
function setApp(html){stopScanner();document.getElementById("app").innerHTML=html;window.scrollTo({top:0,behavior:"smooth"})}

function showLogin(){
 nav();setApp(`<div class="card" style="max-width:520px;margin:auto"><h1>Login</h1><p class="muted">Sign in to access your college event dashboard.</p><p id="loginError" class="error"></p><input id="email" type="email" placeholder="Email" autocomplete="email"><input id="password" type="password" placeholder="Password" autocomplete="current-password"><button onclick="login()">Login</button><button class="btn-secondary" onclick="showRegister()" style="margin-left:7px">Register</button><p class="small"><a href="#" onclick="showForgotPassword();return false;">Forgot password?</a></p><hr><b>Demo accounts</b><p class="small">Admin: admin@college.edu<br>Organizer: organizer@college.edu<br>Student: student1@college.edu<br>Password: password123</p></div>`)
}
async function login(){
 const err=document.getElementById("loginError");err.textContent="";
 try{const d=await api("/api/login",{method:"POST",body:JSON.stringify({email:document.getElementById("email").value.trim(),password:document.getElementById("password").value})});if(d.twoFactorRequired){pendingUserId=d.userId;show2FA(d.message)}}catch(e){err.textContent=e.message}
}
function show2FA(msg){setApp(`<div class="card" style="max-width:520px;margin:auto"><h1>2-Step Verification</h1><p>${esc(msg)}</p><input id="otpCode" inputmode="numeric" maxlength="6" placeholder="Enter 6-digit code"><p id="otpError" class="error"></p><button onclick="verifyOtp()">Verify & Login</button><button class="btn-secondary" onclick="resendOtp()">Resend</button><button class="btn-secondary" onclick="showLogin()">Cancel</button></div>`)}
async function verifyOtp(){try{const d=await api("/api/verify-otp",{method:"POST",body:JSON.stringify({userId:pendingUserId,otpCode:document.getElementById("otpCode").value.trim()})});saveLogin(d);load();}catch(e){document.getElementById("otpError").textContent=e.message;}}
async function resendOtp(){try{showToast((await api("/api/resend-otp",{method:"POST",body:JSON.stringify({userId:pendingUserId})})).message)}catch(e){alert(e.message)}}
let resetUserId=null;
function showForgotPassword(){setApp(`<div class="card" style="max-width:520px;margin:auto"><h1>Reset Password</h1><p class="muted">Enter your account email and we'll send a reset code.</p><input id="fpEmail" type="email" placeholder="Email"><p id="fpError" class="error"></p><button onclick="requestPasswordReset()">Send Reset Code</button><button class="btn-secondary" onclick="showLogin()">Back</button></div>`)}
async function requestPasswordReset(){const err=document.getElementById("fpError");err.textContent="";try{const d=await api("/api/forgot-password",{method:"POST",body:JSON.stringify({email:document.getElementById("fpEmail").value.trim()})});resetUserId=d.userId;showResetPassword(d.message)}catch(e){err.textContent=e.message}}
function showResetPassword(msg){setApp(`<div class="card" style="max-width:520px;margin:auto"><h1>Enter Reset Code</h1><p>${esc(msg)}</p><input id="rpOtp" inputmode="numeric" maxlength="6" placeholder="6-digit code"><input id="rpNewPassword" type="password" placeholder="New password (min 6 characters)"><p id="rpError" class="error"></p><button onclick="submitPasswordReset()">Reset Password</button><button class="btn-secondary" onclick="showLogin()">Cancel</button></div>`)}
async function submitPasswordReset(){const err=document.getElementById("rpError");err.textContent="";try{await api("/api/reset-password",{method:"POST",body:JSON.stringify({userId:resetUserId,otpCode:document.getElementById("rpOtp").value.trim(),newPassword:document.getElementById("rpNewPassword").value})});showToast("Password reset. Please login.");showLogin()}catch(e){err.textContent=e.message}}
function showRegister(){setApp(`<div class="card" style="max-width:560px;margin:auto"><h1>Create Student Account</h1><input id="rname" placeholder="Full Name"><input id="remail" type="email" placeholder="Email Address"><input id="rphone" placeholder="Phone, e.g. +919876543210"><input id="rpassword" type="password" placeholder="Password (min 6 characters)"><input id="rdept" placeholder="Department"><p id="regError" class="error"></p><button onclick="register()">Create Account</button><button class="btn-secondary" onclick="showLogin()">Back</button></div>`)}
async function register(){try{const d=await api("/api/register",{method:"POST",body:JSON.stringify({name:document.getElementById("rname").value.trim(),email:document.getElementById("remail").value.trim(),phone:document.getElementById("rphone").value.trim(),password:document.getElementById("rpassword").value,department:document.getElementById("rdept").value.trim()})});saveLogin(d);load()}catch(e){document.getElementById("regError").textContent=e.message}}

async function loadHome(){
 stopScanner();await nav();
 let events=[];try{events=await api("/api/events")}catch(e){setApp(`<div class="card"><h2>Could not load events</h2><p class="error">${esc(e.message)}</p></div>`);return}
 setApp(`<section class="card hero"><h1>College Events</h1><p>Discover workshops, technical events, cultural programs and sports activities.</p><div class="grid"><input id="search" placeholder="🔎 Search title, venue or description" oninput="searchEvents()"><select id="categoryFilter" onchange="searchEvents()"><option value="">All Categories</option><option>Technical</option><option>Cultural</option><option>Sports</option><option>Workshop</option></select><select id="deptFilter" onchange="searchEvents()"><option value="">All Departments</option><option>Computer Science</option><option>Information Technology</option><option>Physical Education</option><option>All Departments</option></select></div></section><div class="events" id="events"></div>`);
 displayEvents(events)
}
let searchTimer;
async function searchEvents(){clearTimeout(searchTimer);searchTimer=setTimeout(async()=>{try{const q=encodeURIComponent(document.getElementById("search")?.value||"");const c=encodeURIComponent(document.getElementById("categoryFilter")?.value||"");const d=encodeURIComponent(document.getElementById("deptFilter")?.value||"");displayEvents(await api("/api/events?search="+q+"&category="+c+"&department="+d))}catch(e){showToast(e.message)}},200)}
async function refreshSeatsQuietly(){try{const events=await api("/api/events");events.forEach(e=>{const el=document.querySelector(`[data-seats="${e.id}"]`);if(el)el.textContent=e.seatsLeft+" / "+e.maxSeats})}catch{}}
function displayEvents(events){
 const box=document.getElementById("events");if(!box)return;
 if(!events.length){box.innerHTML='<div class="card empty">No events found. Try a different search or filter.</div>';return}
 box.innerHTML=events.map(e=>`<article class="event"><div><span class="badge">${esc(e.category)}</span><h2>${esc(e.title)}</h2><p>${esc(e.description)}</p><p>📅 <b>${fmtDate(e.date)}</b> · ⏰ ${fmtTime(e.time)}</p><p>📍 ${esc(e.venue)}</p><p>🏫 ${esc(e.department||"All Departments")}</p><p>💺 Seats: <span data-seats="${e.id}">${e.seatsLeft} / ${e.maxSeats}</span></p>${e.avgRating?`<p>⭐ ${e.avgRating} (${e.reviewCount} reviews)</p>`:""}</div><div class="actions"><button onclick="eventDetails('${e.id}')">View Details</button>${e.seatsLeft<=0&&e.status!=="completed"?`<button onclick="joinWaitlist('${e.id}')">Join Waitlist</button>`:`<button onclick="registerEvent('${e.id}')" ${e.seatsLeft<=0||e.status==="completed"?"disabled":""}>Register</button>`}<a class="btn btn-secondary" href="/api/events/${e.id}/export-ics">Calendar</a></div></article>`).join("")
}
async function eventDetails(id){
 try{const e=await api("/api/events/"+id);setApp(`<div class="card"><button class="btn-secondary" onclick="loadHome()">← Back</button><span class="badge" style="margin-left:8px">${esc(e.category)}</span><h1>${esc(e.title)}</h1><p>${esc(e.description)}</p><div class="grid"><div><b>📅 Date</b><p>${fmtDate(e.date)}</p></div><div><b>⏰ Time</b><p>${fmtTime(e.time)}</p></div><div><b>📍 Venue</b><p>${esc(e.venue)}</p></div><div><b>💺 Availability</b><p>${e.seatsLeft} / ${e.maxSeats}</p></div></div><div class="actions">${e.seatsLeft<=0?`<button onclick="joinWaitlist('${e.id}')">Join Waitlist</button>`:`<button onclick="registerEvent('${e.id}')">Register Now</button>`}<a class="btn btn-secondary" href="/api/events/${e.id}/export-ics">Add to Calendar</a></div></div><div class="card"><h2>Reviews</h2>${e.reviews?.length?e.reviews.map(r=>`<div class="notif"><b>${esc(r.userName)}</b> · ${"⭐".repeat(Number(r.rating)||0)}<p>${esc(r.comment)}</p></div>`).join(""):'<p class="muted">No reviews yet.</p>'}</div>`)}catch(e){alert(e.message)}}
async function registerEvent(id){if(!user){alert("Please login first");showLogin();return}if(user.role!=="student"){alert("Only student accounts can register for events.");return}try{await api("/api/events/"+id+"/register",{method:"POST"});showToast("Registration successful!");myRegistrations()}catch(e){alert(e.message)}}
async function joinWaitlist(id){if(!user){alert("Please login first");showLogin();return}if(user.role!=="student"){alert("Only student accounts can join a waitlist.");return}try{const d=await api("/api/events/"+id+"/waitlist",{method:"POST"});showToast(d.message)}catch(e){alert(e.message)}}

async function myRegistrations(){
 if(!user){showLogin();return}await nav();
 try{const data=await api("/api/my-registrations");setApp(`<div class="card"><div class="actions" style="justify-content:space-between"><h1>My Registrations</h1><button class="btn-secondary" onclick="loadHome()">Browse Events</button></div>${data.length?data.map(r=>`<div class="card" style="background:white;border:1px solid #ddd"><h2>${esc(r.event?.title||r.eventTitle)}</h2><p>${r.event?fmtDate(r.event.date)+" · "+fmtTime(r.event.time)+" · "+esc(r.event.venue):""}</p><img class="qr" src="${r.qrCode}" alt="Ticket QR"><p style="text-align:center" class="small muted">Check-in code (if QR scan fails): <b style="letter-spacing:2px;font-size:16px">${esc(r.checkinCode)}</b></p><p>Status: ${r.attended?'<span class="success">✓ Attendance verified</span>':'<b>Registered</b> — show this QR at the door'}</p><div class="actions">${r.attended?`<button onclick="downloadCert('${r._id}')">Download Certificate</button><button class="btn-secondary" onclick="reviewEvent('${r.eventId}')">Write Review</button>`:""}</div></div>`).join(""):'<div class="empty">You have no registrations yet.</div>'}</div>`)}catch(e){alert(e.message)}}
async function downloadCert(id){try{const r=await fetch("/api/certificate/"+id,{headers:{Authorization:"Bearer "+token}});if(!r.ok){const x=await r.json();throw new Error(x.error)}const blob=await r.blob(),url=URL.createObjectURL(blob),a=document.createElement("a");a.href=url;a.download="certificate.pdf";a.click();setTimeout(()=>URL.revokeObjectURL(url),1000)}catch(e){alert(e.message)}}
async function reviewEvent(eventId){
 const e=await api("/api/events/"+eventId);let rating=5;
 document.getElementById("modalRoot").style.display="flex";document.getElementById("modalRoot").innerHTML=`<div class="modal"><h2>Review ${esc(e.title)}</h2><p>Rating</p><div id="stars">${[1,2,3,4,5].map(n=>`<span class="star ${n<=5?"on":""}" onclick="setRating(${n})">★</span>`).join("")}</div><textarea id="reviewComment" rows="4" placeholder="Share your experience..."></textarea><p id="reviewErr" class="error"></p><div class="actions"><button onclick="submitReview('${eventId}')">Submit Review</button><button class="btn-secondary" onclick="closeModal()">Cancel</button></div></div>`;
