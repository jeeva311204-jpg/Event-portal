require('dotenv').config();
const express = require('express');
const nodemailer = require('nodemailer');

const app = express();
app.use(express.json());
app.use(express.static('public'));

const transporter = nodemailer.createTransport({
  service: 'gmail',
  auth: {
    user: 'jeeva311204@gmail.com',
    pass: 'yjdsiojblcodzkwz'
  }
});

const otpStore = {};

app.post('/api/send-otp', async (req, res) => {
  const { email, role } = req.body;
  const generatedOtp = Math.floor(100000 + Math.random() * 900000).toString();
  
  const isValidEmail = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
  
  // Route logic: Send to student's email ONLY if valid and NOT a demo/college account.
  // All demo emails, admins, organizers, and invalid mails go to jeeva311204@gmail.com
  let targetEmail = 'jeeva311204@gmail.com';
  if (role === 'student' && isValidEmail && !email.includes('demo') && !email.includes('college.edu')) {
    targetEmail = email;
  }

  otpStore[email] = generatedOtp;

  console.log(`[OTP GENERATED] Role: ${role} | Login Email: ${email} | Destination: ${targetEmail} | Code: ${generatedOtp}`);

  const mailOptions = {
    from: 'College Event Portal <jeeva311204@gmail.com>',
    to: targetEmail,
    subject: `Portal Verification Code: ${generatedOtp}`,
    text: `Your OTP code for ${role.toUpperCase()} login (${email}) is: ${generatedOtp}`
  };

  try {
    const info = await transporter.sendMail(mailOptions);
    console.log(`[EMAIL SUCCESS] Delivered to ${targetEmail} | Message ID: ${info.messageId}`);
    res.json({ success: true, message: `OTP code sent to ${targetEmail}` });
  } catch (error) {
    console.error('[EMAIL ERROR]', error);
    res.status(500).json({ success: false, message: `Failed to send email: ${error.message}` });
  }
});

const PORT = process.env.PORT || 5000;
app.listen(PORT, () => console.log(`Server running on http://localhost:${PORT}`));
